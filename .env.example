# Copy to .env.local and fill in. Never commit real keys.

# Public site URL, used for canonical links, the sitemap and the OG image.
# On Vercel, leave this unset to use the project's production domain automatically,
# or set it to your custom domain (https://...).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres: the /demo form writes to the `leads` table (db/migrations/0001_leads.sql).
# Use the pooled connection string. Server-only: do not prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# The app (/app). Any long random string; signs the sign-in cookie.
SESSION_SECRET=
# One-time code needed on /app to create a venue. Choose any hard-to-guess value.
APP_SETUP_CODE=
# Optional. Demo games play this many times faster than real time (default 6).
SIM_SPEED=

# Resend: new-lead email notification.
RESEND_API_KEY=
# Where new-lead emails go.
LEADS_NOTIFY_EMAIL=
# Must be an address on a domain verified in Resend.
LEADS_FROM_EMAIL=

# Any long random string. Salts the IP hash used for rate limiting.
LEADS_IP_SALT=
