# Copy to .env.local and fill in. Never commit real keys.

# Public site URL, used for canonical links, the sitemap and the OG image.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: the /demo form writes to the `leads` table (supabase/migrations/0001_leads.sql).
# The service-role key is server-only. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: new-lead email notification.
RESEND_API_KEY=
# Where new-lead emails go.
LEADS_NOTIFY_EMAIL=
# Must be an address on a domain verified in Resend.
LEADS_FROM_EMAIL=

# Any long random string. Salts the IP hash used for rate limiting.
LEADS_IP_SALT=
